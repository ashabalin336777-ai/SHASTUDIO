DATABASE_URL="file:./data/shastudio.db"

BACKEND_PORT=3001
JWT_SECRET="change-me"
BCRYPT_ROUNDS=10
VSELLM_API_KEY="your-api-key"
# OpenAI-compatible base URL for VseLLM
VSELLM_BASE_URL="https://api.vsellm.ru/v1"
