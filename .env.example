# Local / host-side Prisma (backend outside Docker). Inside Docker this is overridden by compose.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/shastudio?schema=public"

# Postgres (used by docker compose for db + backend DATABASE_URL host=db)
POSTGRES_PASSWORD=postgres

BACKEND_PORT=3001
JWT_SECRET="change-me"
BCRYPT_ROUNDS=10
VSELLM_API_KEY="your-api-key"
VSELLM_BASE_URL="https://api.vsellm.ru/v1"
VSELLM_MODEL="qwen-70b"

# Prod (через Nginx + SSL на shastudio.ru):
NEXT_PUBLIC_API_URL=https://shastudio.ru
NEXTAUTH_URL=https://shastudio.ru

# Local Docker без домена (раскомментируйте):
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXTAUTH_URL=http://localhost:3010

NEXT_PUBLIC_APP_NAME="ShaStudio"
NEXT_PUBLIC_VSELLM_API_KEY="your-api-key"
NEXTAUTH_SECRET="change-me"
ADMIN_EMAIL=admin@shastudio.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
ADMIN_PASSWORD_FORCE=false
